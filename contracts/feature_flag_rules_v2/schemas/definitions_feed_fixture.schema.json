{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://posthog.com/contracts/feature_flag_rules_v2/definitions_feed_fixture.schema.json",
  "title": "Definitions feed fixture",
  "description": "A whole definitions feed and, for each of its entries in order, what a local evaluator does with the entry. The feed is not checked here: it holds entries that the feed schema rejects on purpose.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "description",
    "feed",
    "context",
    "expectations"
  ],
  "properties": {
    "schema": {
      "const": "schemas/definitions_v2.schema.json"
    },
    "description": {
      "type": "string"
    },
    "feed": {
      "type": "object",
      "additionalProperties": true,
      "x-posthog-open-object": "The feed body as a server sends it. Without the entries whose producer_expected is invalid, it matches the feed schema."
    },
    "context": {
      "$ref": "urn:posthog:feature-flag-rules-v2:corpus:v2_local_evaluation:1.0.0#/$defs/context",
      "required": [
        "identifier",
        "properties",
        "properties_complete",
        "timezone",
        "explicit_exact_matching",
        "now"
      ]
    },
    "expectations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/expectation"
      }
    }
  },
  "$defs": {
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "producer_expected",
        "reader"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "description": "The key of the feed entry at the same position."
        },
        "producer_expected": {
          "enum": [
            "valid",
            "invalid"
          ],
          "description": "Whether the entry matches the definitions entry schema."
        },
        "producer_failure": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "layer",
            "keyword",
            "instance_path"
          ],
          "properties": {
            "layer": {
              "const": "schema"
            },
            "keyword": {
              "type": "string"
            },
            "instance_path": {
              "type": "string",
              "description": "A JSON Pointer from the entry, not from the feed."
            },
            "message_contains": {
              "type": "string"
            }
          }
        },
        "evaluator": {
          "enum": [
            "v1",
            "v2"
          ],
          "description": "The evaluator arm that filters.version selects for an entry the reader supports."
        },
        "reader": {
          "description": "What the reader does with the entry in each SDK mode, before any context.",
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "auto",
                "local_only"
              ],
              "properties": {
                "auto": {
                  "const": "local_evaluation"
                },
                "local_only": {
                  "const": "local_evaluation"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "auto",
                "local_only"
              ],
              "properties": {
                "auto": {
                  "const": "remote_fallback"
                },
                "local_only": {
                  "const": "unsupported"
                }
              }
            }
          ]
        },
        "expected": {
          "$ref": "urn:posthog:feature-flag-rules-v2:corpus:v2_local_evaluation:1.0.0#/$defs/result",
          "description": "The config version 2 result for the fixture context."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "producer_expected": {
                "const": "invalid"
              }
            }
          },
          "then": {
            "required": [
              "producer_failure"
            ]
          },
          "else": {
            "not": {
              "required": [
                "producer_failure"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "reader": {
                "properties": {
                  "auto": {
                    "const": "local_evaluation"
                  }
                }
              }
            }
          },
          "then": {
            "required": [
              "evaluator"
            ]
          },
          "else": {
            "not": {
              "required": [
                "evaluator"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "evaluator": {
                "const": "v2"
              }
            },
            "required": [
              "evaluator"
            ]
          },
          "then": {
            "required": [
              "expected"
            ]
          },
          "else": {
            "not": {
              "required": [
                "expected"
              ]
            }
          }
        }
      ]
    }
  }
}
