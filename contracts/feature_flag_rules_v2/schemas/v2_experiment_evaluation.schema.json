{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:posthog:feature-flag-rules-v2:corpus:v2_experiment_evaluation:1.0.0",
  "$defs": {
    "context": {
      "type": "object",
      "properties": {
        "identifier": {
          "type": "string"
        },
        "properties": {
          "type": "object",
          "additionalProperties": true,
          "x-posthog-open-object": "supplied person property values"
        },
        "properties_complete": {
          "const": true
        },
        "timezone": {
          "type": "string"
        },
        "explicit_exact_matching": {
          "type": "boolean"
        },
        "now": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "corpus_version": {
      "const": "1.0.0"
    },
    "config_version": {
      "const": 2
    },
    "description": {
      "type": "string"
    },
    "defaults": {
      "type": "object",
      "description": "The flag and context of every case. A case's context fields replace the default context fields of the same name.",
      "properties": {
        "flag": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "active": {
              "const": true
            },
            "deleted": {
              "const": false
            },
            "requested": {
              "const": true
            }
          },
          "required": [
            "key",
            "name",
            "active",
            "deleted",
            "requested"
          ],
          "additionalProperties": false
        },
        "context": {
          "$ref": "#/$defs/context",
          "required": [
            "identifier",
            "properties",
            "properties_complete",
            "timezone",
            "explicit_exact_matching",
            "now"
          ]
        }
      },
      "required": [
        "flag",
        "context"
      ],
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^v2_experiment(\\.[a-z0-9_]+)+$"
          },
          "family": {
            "enum": [
              "ordering",
              "assignment",
              "values",
              "white_box",
              "parser"
            ]
          },
          "config": {
            "type": "object",
            "properties": {
              "return_type": {
                "enum": [
                  "boolean",
                  "string",
                  "number",
                  "object"
                ]
              }
            },
            "required": [
              "return_type"
            ],
            "additionalProperties": true,
            "x-posthog-open-object": "validated separately against the canonical config schema, including rejected examples"
          },
          "context": {
            "$ref": "#/$defs/context",
            "minProperties": 1
          },
          "expected": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "success"
                  },
                  "value": {
                    "type": [
                      "boolean",
                      "string",
                      "number",
                      "object",
                      "null"
                    ]
                  },
                  "reason": {
                    "enum": [
                      "targeting_match",
                      "experiment_split",
                      "rollout_miss",
                      "experiment_paused",
                      "holdout",
                      "no_rule_match"
                    ]
                  },
                  "rule": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "rule_type": {
                        "enum": [
                          "targeted_release",
                          "percentage_rollout",
                          "experiment"
                        ]
                      },
                      "index": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "id",
                      "rule_type",
                      "index"
                    ],
                    "additionalProperties": false
                  },
                  "variant": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]+$",
                    "description": "The assigned variant key, which a response record carries as variant_key."
                  }
                },
                "required": [
                  "status",
                  "value",
                  "reason"
                ],
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "reason": {
                          "const": "no_rule_match"
                        }
                      }
                    },
                    "then": {
                      "not": {
                        "required": [
                          "rule"
                        ]
                      }
                    },
                    "else": {
                      "required": [
                        "rule"
                      ]
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "reason": {
                          "const": "experiment_split"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "variant"
                      ],
                      "properties": {
                        "rule": {
                          "properties": {
                            "rule_type": {
                              "const": "experiment"
                            }
                          }
                        }
                      }
                    },
                    "else": {
                      "not": {
                        "required": [
                          "variant"
                        ]
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "reason": {
                          "const": "targeting_match"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "rule": {
                          "properties": {
                            "rule_type": {
                              "enum": [
                                "targeted_release",
                                "percentage_rollout"
                              ]
                            }
                          }
                        }
                      }
                    }
                  }
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "parse_error"
                  },
                  "kind": {
                    "const": "malformed"
                  }
                },
                "required": [
                  "status",
                  "kind"
                ],
                "additionalProperties": false
              }
            ]
          },
          "hash_evidence": {
            "type": "array",
            "minItems": 1,
            "description": "Every hash the evaluation draws, in draw order: holdout, rollout, then variant.",
            "items": {
              "type": "object",
              "properties": {
                "use": {
                  "enum": [
                    "holdout",
                    "rollout",
                    "variant"
                  ]
                },
                "prefix": {
                  "type": "string"
                },
                "identifier": {
                  "type": "string"
                },
                "salt": {
                  "enum": [
                    "",
                    "variant"
                  ]
                },
                "hash01_binary64_hex": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{16}$"
                }
              },
              "required": [
                "use",
                "prefix",
                "identifier",
                "salt",
                "hash01_binary64_hex"
              ],
              "oneOf": [
                {
                  "properties": {
                    "use": {
                      "enum": [
                        "holdout",
                        "rollout"
                      ]
                    },
                    "salt": {
                      "const": ""
                    }
                  }
                },
                {
                  "properties": {
                    "use": {
                      "const": "variant"
                    },
                    "salt": {
                      "const": "variant"
                    }
                  }
                }
              ],
              "additionalProperties": false
            }
          },
          "white_box": {
            "type": "object",
            "description": "A private test seam returns hash01_binary64_hex for every hash the evaluation draws; boundary and relation record the comparison that decides the case.",
            "properties": {
              "hash01_binary64_hex": {
                "type": "string",
                "pattern": "^[0-9a-f]{16}$"
              },
              "against": {
                "enum": [
                  "holdout_threshold",
                  "rollout_threshold",
                  "variant_boundary"
                ]
              },
              "boundary_binary64_hex": {
                "type": "string",
                "pattern": "^[0-9a-f]{16}$"
              },
              "relation": {
                "enum": [
                  "below",
                  "equal",
                  "above"
                ]
              }
            },
            "required": [
              "hash01_binary64_hex",
              "against",
              "boundary_binary64_hex",
              "relation"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "family",
          "config",
          "expected"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "expected": {
                  "properties": {
                    "status": {
                      "const": "parse_error"
                    }
                  }
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "hash_evidence"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "family": {
                  "const": "white_box"
                }
              }
            },
            "then": {
              "required": [
                "white_box"
              ],
              "not": {
                "required": [
                  "hash_evidence"
                ]
              }
            },
            "else": {
              "not": {
                "required": [
                  "white_box"
                ]
              }
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "corpus_version",
    "config_version",
    "description",
    "defaults",
    "cases"
  ],
  "additionalProperties": false
}
