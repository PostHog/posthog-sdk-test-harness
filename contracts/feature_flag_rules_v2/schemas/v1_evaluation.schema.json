{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:posthog:feature-flag-rules-v2:corpus:v1_evaluation:1.0.0",
  "title": "Version 1 evaluation corpus",
  "description": "Companion schema for corpus/v1_evaluation.json. The flag shape is the fixture input shape, not a definitions feed contract.",
  "type": "object",
  "required": [
    "corpus_version",
    "config_version",
    "description",
    "definition_shape",
    "context_shape",
    "expectation_rules",
    "reason_codes",
    "cases"
  ],
  "properties": {
    "corpus_version": {
      "$ref": "#/$defs/semver"
    },
    "config_version": {
      "const": 1
    },
    "description": {
      "type": "string"
    },
    "definition_shape": {
      "type": "string"
    },
    "context_shape": {
      "type": "string"
    },
    "expectation_rules": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "x-posthog-open-object": "prose_definition"
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/reasonCode"
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "caseId": {
      "type": "string",
      "pattern": "^v1(\\.[a-z0-9_]+)+$"
    },
    "flagKey": {
      "type": "string",
      "minLength": 1
    },
    "reasonCode": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "percentage": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "unitInterval": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "propertyFilter": {
      "type": "object",
      "required": [
        "key",
        "type"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "person",
            "group",
            "cohort",
            "flag"
          ]
        },
        "operator": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": {},
        "group_type_index": {
          "type": [
            "integer",
            "null"
          ]
        },
        "negation": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "dependency_chain": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/flagKey"
          }
        }
      },
      "additionalProperties": false
    },
    "condition": {
      "type": "object",
      "required": [
        "properties",
        "rollout_percentage"
      ],
      "properties": {
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/propertyFilter"
          }
        },
        "rollout_percentage": {
          "anyOf": [
            {
              "$ref": "#/$defs/percentage"
            },
            {
              "type": "null"
            }
          ]
        },
        "variant": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "variant": {
      "type": "object",
      "required": [
        "key",
        "rollout_percentage"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "rollout_percentage": {
          "$ref": "#/$defs/percentage"
        }
      },
      "additionalProperties": false
    },
    "holdout": {
      "type": "object",
      "required": [
        "id",
        "exclusion_percentage"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "exclusion_percentage": {
          "$ref": "#/$defs/percentage"
        }
      },
      "additionalProperties": false
    },
    "filters": {
      "type": "object",
      "required": [
        "groups"
      ],
      "properties": {
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "multivariate": {
          "type": "object",
          "required": [
            "variants"
          ],
          "properties": {
            "variants": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/variant"
              }
            }
          },
          "additionalProperties": false
        },
        "payloads": {
          "type": "object",
          "additionalProperties": {},
          "x-posthog-open-object": "payloads_by_match_key"
        },
        "aggregation_group_type_index": {
          "type": "integer",
          "minimum": 0
        },
        "holdout": {
          "$ref": "#/$defs/holdout"
        },
        "early_exit": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "flag": {
      "type": "object",
      "required": [
        "id",
        "key",
        "version",
        "active",
        "filters"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "key": {
          "$ref": "#/$defs/flagKey"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "active": {
          "type": "boolean"
        },
        "filters": {
          "$ref": "#/$defs/filters"
        }
      },
      "additionalProperties": false
    },
    "definitions": {
      "type": "object",
      "required": [
        "flags"
      ],
      "properties": {
        "flags": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/flag"
          }
        },
        "group_type_mapping": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[0-9]+$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "x-posthog-open-object": "group_type_index_to_name"
        }
      },
      "additionalProperties": false
    },
    "propertyMap": {
      "type": "object",
      "additionalProperties": {},
      "x-posthog-open-object": "property_values"
    },
    "context": {
      "type": "object",
      "required": [
        "distinct_id",
        "person_properties"
      ],
      "properties": {
        "distinct_id": {
          "type": "string",
          "minLength": 1
        },
        "person_properties": {
          "$ref": "#/$defs/propertyMap"
        },
        "groups": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "integer"
            ]
          },
          "x-posthog-open-object": "group_keys_by_type_name"
        },
        "group_properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/propertyMap"
          },
          "x-posthog-open-object": "group_properties_by_type_name"
        }
      },
      "additionalProperties": false
    },
    "reason": {
      "type": "object",
      "required": [
        "code",
        "condition_index"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/reasonCode"
        },
        "condition_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "expectedFlag": {
      "type": "object",
      "required": [
        "value",
        "enabled",
        "variant",
        "payload",
        "reason",
        "local_evaluation"
      ],
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "variant": {
          "type": [
            "string",
            "null"
          ]
        },
        "payload": {},
        "reason": {
          "$ref": "#/$defs/reason"
        },
        "local_evaluation": {
          "enum": [
            "conclusive",
            "inconclusive",
            "remote_only"
          ]
        }
      },
      "additionalProperties": false
    },
    "hashEvidence": {
      "type": "object",
      "required": [
        "purpose",
        "input",
        "hash01"
      ],
      "properties": {
        "purpose": {
          "enum": [
            "rollout",
            "variant",
            "holdout"
          ]
        },
        "input": {
          "type": "string",
          "minLength": 1
        },
        "hash01": {
          "$ref": "#/$defs/unitInterval"
        },
        "threshold_percentage": {
          "$ref": "#/$defs/percentage"
        },
        "threshold": {
          "$ref": "#/$defs/unitInterval"
        },
        "included": {
          "type": "boolean"
        },
        "cumulative_boundaries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "selected": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": [
        "id",
        "definitions",
        "context",
        "expected"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/caseId"
        },
        "definitions": {
          "$ref": "#/$defs/definitions"
        },
        "context": {
          "$ref": "#/$defs/context"
        },
        "expected": {
          "type": "object",
          "required": [
            "flags",
            "omitted_flags"
          ],
          "properties": {
            "flags": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/expectedFlag"
              },
              "x-posthog-open-object": "expected_by_flag_key"
            },
            "omitted_flags": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/flagKey"
              }
            }
          },
          "additionalProperties": false
        },
        "hash_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/hashEvidence"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
